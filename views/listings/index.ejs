<% layout("/layouts/boilerplate") %>

    <!-- Tags / Filter section -->
    <div id="filters">
        <% const tags=[ { name: "All", icon: "fa-border-all" }, { name: "Trending" , icon: "fa-fire" }, { name: "Surfing" , icon: "fa-water" }, {
            name: "Amazing cities" , icon: "fa-city" }, { name: "Beach" , icon: "fa-umbrella" }, { name: "Farms" ,
            icon: "fa-cow" }, { name: "Lake" , icon: "fa-mountain" }, { name: "Castles" ,
            icon: "fa-brands fa-fort-awesome" }, { name: "Rooms" , icon: "fa-bed" }, { name: "Forest" , icon: "fa-tree"
            }, { name: "Pool" , icon: "fa-person-swimming" } ]; %>

        <div class="filters-wrapper" id="filtersWrapper">
            <% tags.forEach(t=> { %>
                <% const isActive = (t.name === "All" && !tag) || (t.name === tag); %>
                <div class="filter <%= isActive ? 'active' : '' %>" style="<%= isActive ? 'opacity: 1; border-bottom: 2px solid black;' : 'opacity: 0.6;' %>">
                    <a style="text-decoration: none; color: inherit;" href="<%= t.name === 'All' ? '/listings' : '/listings?tag=' + t.name %>" class="filter-link">
                        <div><i class="fa-solid <%= t.icon %>"></i></div>
                        <p><%= t.name %></p>
                    </a>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Listings Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 mt-3 mb-5 mx-2 mx-md-3 g-4">
        <% for(let listing of allListings){ %>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="listing-card">
                        <div class="listing-img-wrap">
                            <img src="<%= listing.image.url %>" class="listing-img" alt="listing_img">
                            
                            <% if (currUser) { %>
                                <% const isFav = currUser.favorites && currUser.favorites.some(fav => fav.toString() === listing._id.toString()); %>
                                <div class="favorite-btn <%= isFav ? 'favorited' : '' %>" data-id="<%= listing._id %>" onclick="event.preventDefault(); toggleFavorite(this, '<%= listing._id %>')">
                                    <i class="<%= isFav ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                                </div>
                            <% } %>

                            <div class="listing-overlay">
                                <div class="listing-info">
                                    <p class="listing-title"><%= listing.title %></p>
                                    <p class="listing-price">&#8377;<%= listing.price.toLocaleString("en-In") %> / night</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>