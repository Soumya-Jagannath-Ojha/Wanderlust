<% layout("/layouts/boilerplate") %>
<div class="row mt-3 mb-5">
    <div class="col-md-8 offset-md-2 col-xl-8 offset-xl-2">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-md-5 p-4">
                <h2 class="fw-bold mb-4 text-center">Create a New Listing</h2>
                <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label for="title" class="form-label fw-semibold">Title</label>
                        <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control rounded-3 py-2" required />
                        <div class="valid-feedback">Title looks Good!</div>
                        <div class="invalid-feedback">Please enter a valid title</div>
                    </div>

                    <div class="mb-4">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea name="listing[description]" placeholder="Describe the place in detail..." class="form-control rounded-3 py-2" rows="4" required></textarea>
                        <div class="invalid-feedback">Please enter a short description</div>
                    </div>

                    <div class="mb-4">
                        <label for="image" class="form-label fw-semibold">Upload New Image</label>
                        <input name="listing[image]" type="file" class="form-control rounded-3 py-2" required>
                        <div class="invalid-feedback">Please provide an image</div>
                    </div>

                    <!-- Tags section -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Tags</label>
                        <div class="d-flex flex-wrap gap-2">
                            <% const tags=["Trending", "Surfing", "Amazing cities", "Beach", "Farms", "Lake", "Castles", "Rooms", "Forest", "Pool"]; %>
                            <% tags.forEach(tag => { %>
                                <div>
                                    <input type="checkbox" class="btn-check tag-checkbox" name="listing[tag]" id="tag<%= tag %>" value="<%= tag %>" autocomplete="off">
                                    <label class="btn btn-outline-primary rounded-pill px-3 py-1 fw-semibold" style="font-size: 0.9rem;" for="tag<%= tag %>"><%= tag %></label>
                                </div>
                            <% }) %>
                        </div>
                        <small class="text-muted d-block mt-2"><i class="fa-solid fa-circle-info me-1"></i>Maximum 3 tags are allowed!</small>
                    </div>

                    <div class="row">
                        <div class="mb-4 col-md-4">
                            <label for="price" class="form-label fw-semibold">Price per night</label>
                            <div class="input-group shadow-sm rounded-3">
                                <span class="input-group-text rounded-start-3 bg-white border-end-0 fw-bold">&#8377;</span>
                                <input name="listing[price]" placeholder="1200" type="number" class="form-control rounded-end-3 py-2 border-start-0" required>
                                <div class="invalid-feedback">Price should be valid</div>
                            </div>
                        </div>
                        <div class="mb-4 col-md-8">
                            <label for="country" class="form-label fw-semibold">Country</label>
                            <input name="listing[country]" placeholder="India" type="text" class="form-control rounded-3 py-2" required>
                            <div class="invalid-feedback">Country should be valid</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="location" class="form-label fw-semibold">Location</label>
                        <input name="listing[location]" placeholder="Cuttack, Odisha" type="text" class="form-control rounded-3 py-2" required>
                        <div class="invalid-feedback">Location should be valid</div>
                    </div>

                    <div class="d-grid mt-4">
                        <button class="btn btn-secondary py-2 fw-semibold rounded-pill shadow-sm">Add New Listing</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
