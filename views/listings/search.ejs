<% layout("/layouts/boilerplate") %>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 mt-3 mx-2 mx-md-3 g-4">
    <% for(let listing of results){ %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="listing-card">
                    <div class="listing-img-wrap">
                        <img src="<%= listing.image.url %>" class="listing-img" alt="listing_img">
                        <div class="listing-overlay">
                            <div class="listing-info">
                                <p class="listing-title"><%= listing.title %></p>
                                <p class="listing-price">&#8377;<%= listing.price.toLocaleString("en-In") %> / night</p>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>