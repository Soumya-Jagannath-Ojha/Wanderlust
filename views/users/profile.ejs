<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
    <div class="col-md-8 offset-md-2 col-xl-6 offset-xl-3">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5 text-center">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-dark mb-4 bg-secondary" style="width: 100px; height: 100px;">
                    <i class="fa-solid fa-user fa-3x"></i>
                </div>
                <h2 class="fw-bold mb-1">@<%= currUser.username %></h2>
                <p class="text-muted mb-4">Explorer</p>
                
                <div class="text-start bg-light p-4 rounded-4 mb-4">
                    <h5 class="fw-semibold border-bottom pb-3 mb-3 text-secondary">Profile Details</h5>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-semibold">Username</div>
                        <div class="col-sm-8 fw-bold">@<%= currUser.username %></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted fw-semibold">Email</div>
                        <div class="col-sm-8 fw-bold"><%= currUser.email %></div>
                    </div>
                </div>
                
                <div class="d-flex justify-content-center gap-3">
                    <a href="/listings" class="btn btn-outline-secondary rounded-3 px-4 shadow-sm fw-semibold">Back to Listings</a>
                </div>
            </div>
        </div>
    </div>
</div>
